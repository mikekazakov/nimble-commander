    "This will cause Nimble Commander to ask you for access when necessary." : {
      "comment" : "Informative text saying that Nimble Commander will ask for filesystem access when need it",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimble Commander будет спрашивать вас о предоставлении доступа при необходимости."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会使 Nimble Commander 在需要时向你请求访问权限。"
          }
        }
      }
    },
    "This will clear any custom hotkeys." : {
      "comment" : "Informative text when user wants to reset hotkeys to defaults",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши изменения горячих клавиш будут удалены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将清除所有自定义快捷键。"
          }
        }
      }
    },
    "This will erase stored positions, encodings, selections, etc." : {
