    "Are you sure you want to clear saved file states?" : {
      "comment" : "Message text asking if user really wants to clear saved viewer file states",
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы действительно хотите очистить сохраненные состояния файлов?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定要清除已存储的文件状态吗？"
          }
        }
      }
    },
    "Are you sure you want to reset granted filesystem access?" : {
