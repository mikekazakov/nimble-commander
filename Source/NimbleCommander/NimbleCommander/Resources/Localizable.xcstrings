    "__THANKS_FOR_REGISTER_INFORMATIVE" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thank you for using a registered copy of Nimble Commander! Please restart it for the changes to take effect."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо за использование зарегистрированной копии Nimble Commander!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢你使用 Nimble Commander 的已注册副本！请重新启动以使更改生效。"
          }
        }
      }
    },
    "__THANKS_FOR_REGISTER_MESSAGE" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activated successfully"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Успешная активация"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "激活成功"
          }
        }
      }
    },
    "__TRIAL_WINDOW_NOTE" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a trial version of Nimble Commander.\nTo continue using this software after the 30-day trial period, you have to either buy a license or install the paid version from Mac App Store.\nThis window appears only in the trial version."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это пробная версия Nimble Commander.\nЧтобы продолжить использование этого продукта после окончания пробного периода в 30 дней, Вам нужно купить лицензию или установить платную версию из Mac App Store.\nЭто окно появляется только в пробной версии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是 Nimble Commander 的试用版。\n30 天试用期结束后若需继续使用本软件，你必须购买许可证或从 Mac App Store 安装付费版本。\n此窗口仅在试用版中显示。"
          }
        }
      }
    },
    "“%@” is %@ in size.\nAre you sure you want to open it?" : {
